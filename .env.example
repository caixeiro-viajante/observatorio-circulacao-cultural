# =============================================================================
# Livedashboard environment variables
# Copy this file to .env.local and fill in only the values you need.
# Any platform left blank will fall back to mock data automatically.
# =============================================================================

# Force every platform to use mock data, even if credentials are present.
# Useful for public demos.
DEMO_MODE=false

# -----------------------------------------------------------------------------
# Brand overrides (optional). Default values come from brand.config.ts.
# Use these on Vercel to customize a deployment without forking the repo.
# -----------------------------------------------------------------------------
# BRAND_NAME="Acme Co."
# BRAND_PRIMARY="#0F62FE"
# BRAND_ACCENT="#FF6B35"

# -----------------------------------------------------------------------------
# X (Twitter) — https://developer.x.com
# -----------------------------------------------------------------------------
# X_BEARER_TOKEN=
# X_USER_ID=

# -----------------------------------------------------------------------------
# YouTube Data API v3 — https://console.cloud.google.com (enable YouTube Data API v3)
# -----------------------------------------------------------------------------
# YOUTUBE_API_KEY=
# YOUTUBE_CHANNEL_ID=

# -----------------------------------------------------------------------------
# LinkedIn Marketing Developer Platform
# Requires Marketing Developer Platform partnership approval.
# https://learn.microsoft.com/en-us/linkedin/marketing/
# -----------------------------------------------------------------------------
# LINKEDIN_ACCESS_TOKEN=
# LINKEDIN_ORG_URN=

# -----------------------------------------------------------------------------
# Instagram Graph API — https://developers.facebook.com/docs/instagram-api/
# Requires a Business or Creator IG account linked to a Facebook Page.
# -----------------------------------------------------------------------------
# IG_ACCESS_TOKEN=
# IG_BUSINESS_ACCOUNT_ID=

# -----------------------------------------------------------------------------
# TikTok for Developers — https://developers.tiktok.com
# Research API requires application + approval.
# -----------------------------------------------------------------------------
# TIKTOK_ACCESS_TOKEN=

# -----------------------------------------------------------------------------
# Daily report delivery (optional)
# At least one webhook must be set for /api/cron/daily to send anything.
# -----------------------------------------------------------------------------
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/XXX/YYY

# Required if you want to lock down /api/cron/daily.
# Vercel Cron automatically sets the Authorization: Bearer header for you.
# CRON_SECRET=

# Threads Insights (central observatory source)
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=

# Google Trends official alpha or approved export/provider
GOOGLE_TRENDS_API_URL=
GOOGLE_TRENDS_API_TOKEN=
